{
  "name": "meta-pricing-automation-playwright",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright BDD Test Automation Suite for Meta New Pricing 2026",
  "main": "index.js",
  "scripts": {
    "bdd:gen": "bddgen",
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && playwright test --headed",
    "test:ui": "bddgen && playwright test --ui",
    "test:api": "bddgen && playwright test --grep @api",
    "test:e2e": "bddgen && playwright test --grep @e2e",
    "test:critical": "bddgen && playwright test --grep @Auto-Critical",
    "report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report"
  },
  "keywords": [
    "playwright",
    "bdd",
    "cucumber",
    "typescript",
    "test-automation",
    "triple-layer-assertion"
  ],
  "author": "QA Team",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "^22.10.2",
    "allure-playwright": "2.15.1",
    "dotenv": "^16.4.7",
    "playwright-bdd": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
